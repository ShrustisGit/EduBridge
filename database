CREATE DATABASE IF NOT EXISTS EduBridge;

USE EduBridge;


CREATE TABLE students(
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(100) UNIQUE,
    contact VARCHAR(15),
    password VARCHAR(255),
    university_name VARCHAR(200),
    education VARCHAR(100),
    branch VARCHAR(100),
    city VARCHAR(100),
    enrollment_no VARCHAR(50)
);


CREATE TABLE projects(
    id INT AUTO_INCREMENT PRIMARY KEY,
    student_id INT NOT NULL,
    title VARCHAR(255) NOT NULL,
    short_description TEXT,
    detailed_description LONGTEXT,
    funding_required DECIMAL(12,2) NOT NULL,
    interest DECIMAL(5,2) NOT NULL,
    return_months INT NOT NULL,
    project_pdf VARCHAR(255),
    category VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(student_id)
    REFERENCES students(id)
);



CREATE TABLE investors (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100),
    company_name VARCHAR(255) NOT NULL,
    role_at_company VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    contact VARCHAR(15) NOT NULL,
    about_company TEXT,
    registration_no VARCHAR(100) NOT NULL,
    city VARCHAR(100) NOT NULL,
    password VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE project_conversations (
    id INT AUTO_INCREMENT PRIMARY KEY,
    project_id INT NOT NULL,
    student_id INT NOT NULL,
    investor_id INT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


CREATE TABLE chat_messages (
    id INT AUTO_INCREMENT PRIMARY KEY,
    room_id INT NOT NULL,
    sender_id INT NOT NULL,
    sender_type VARCHAR(20) NOT NULL,
    message TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE investment_requests(
    id INT AUTO_INCREMENT PRIMARY KEY,
    project_id INT NOT NULL,
	student_id INT NOT NULL,
    investor_id INT NOT NULL,
    status ENUM(
        'Pending',
        'Approved',
        'Rejected'
    ) DEFAULT 'Pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(project_id)
    REFERENCES projects(id),
    FOREIGN KEY(student_id)
    REFERENCES students(id),
    FOREIGN KEY(investor_id)
    REFERENCES investors(id)
);

RENAME TABLE chat_messages_new TO chat_messages;

RENAME TABLE chat_rooms TO project_conversations;
